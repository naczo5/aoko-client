<UserControl x:Class="Aoko.Views.CommandSearchOverlay"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="clr-namespace:Aoko.Views"
             Visibility="Collapsed"
             Focusable="False"
             IsTabStop="False"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             TextElement.Foreground="{DynamicResource DimTextBrush}">

    <UserControl.Resources>
        <!-- Structural glass rim only; every tint comes from the palette so a light theme cannot invert it.
             CommandSearchMatchBrush, CommandSearchMatchPillBrush, CommandSearchSubtleTextBrush and
             CommandSearchPlaceholderBrush are built in MainWindow.ApplyGuiTheme from the live palette. -->
        <SolidColorBrush x:Key="GlassHairlineBrush" Color="#2E8EB1CC"/>
        <SolidColorBrush x:Key="GlassSpecularBrush" Color="#14FFFFFF"/>

        <Style x:Key="EscChipStyle" TargetType="Button">
            <Setter Property="Focusable" Value="False"/>
            <Setter Property="IsTabStop" Value="False"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Foreground" Value="{DynamicResource CommandSearchSubtleTextBrush}"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chip"
                                Background="{DynamicResource SliderBgBrush}"
                                BorderBrush="{DynamicResource SliderFgBrush}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="7,2">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Overlay switch: ModuleSwitch geometry and colours, but state arrives as plain setters. A storyboard
             on IsChecked replays "switched on" whenever a container is rebuilt, i.e. for every ON module on
             most keystrokes; a setter cannot animate on template application. -->
        <Style x:Key="RowSwitchStyle" TargetType="CheckBox" BasedOn="{StaticResource ModuleSwitch}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid Width="46" Height="24">
                            <Border x:Name="Track" CornerRadius="12"
                                    Background="{DynamicResource SliderBgBrush}"
                                    BorderBrush="{DynamicResource SliderFgBrush}" BorderThickness="1"/>
                            <Border x:Name="Accent" CornerRadius="12"
                                    Background="{DynamicResource AccentBrush}" Opacity="0"/>
                            <Ellipse x:Name="Thumb" Width="18" Height="18"
                                     Fill="{DynamicResource SliderFgBrush}"
                                     HorizontalAlignment="Left" Margin="3,0,0,0" VerticalAlignment="Center"/>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Thumb" Property="HorizontalAlignment" Value="Right"/>
                                <Setter TargetName="Thumb" Property="Margin" Value="0,0,3,0"/>
                                <Setter TargetName="Thumb" Property="Fill" Value="{DynamicResource TextBrush}"/>
                                <Setter TargetName="Accent" Property="Opacity" Value="1"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Track" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.6"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Secondary row text (hint, keybind chip, UNAVAILABLE): lifts to the palette's subtle tone once the
             row has a wash under it, because a wash lowers contrast and DimText only clears AA on the bare card. -->
        <Style x:Key="RowSecondaryTextStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CommandSearchSubtleTextBrush}"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type views:CommandSearchRow}}}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource CommandSearchSubtleTextBrush}"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="{x:Type views:CommandSearchRow}">
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="VerticalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type views:CommandSearchRow}">
                        <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="{x:Type views:CommandSearchResults}">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type views:CommandSearchResults}">
                        <ItemsPresenter/>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <!-- Two vertical stops only: the blurred GUI stays legible as texture under the glass -->
        <Border x:Name="Scrim" Opacity="0" MouseLeftButtonDown="Scrim_MouseLeftButtonDown">
            <Border.Background>
                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                    <GradientStop Color="#9C020711" Offset="0"/>
                    <GradientStop Color="#D9050B17" Offset="1"/>
                </LinearGradientBrush>
            </Border.Background>
        </Border>

        <!-- Card host: top-anchored from code so filtering never re-centres the query field -->
        <Grid VerticalAlignment="Top" HorizontalAlignment="Center">
            <!-- Moon haze: a fixed 760 px disc centred on the card, zero layout footprint -->
            <Canvas Width="0" Height="0" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                <Border Canvas.Left="-380" Canvas.Top="-380" Width="760" Height="760">
                    <Border.Background>
                        <RadialGradientBrush Center="0.5,0.5" GradientOrigin="0.5,0.5" RadiusX="0.5" RadiusY="0.5">
                            <GradientStop Color="#3D7F9EFF" Offset="0"/>
                            <GradientStop Color="#1A2B3A86" Offset="0.45"/>
                            <GradientStop Color="#00070F20" Offset="1"/>
                        </RadialGradientBrush>
                    </Border.Background>
                </Border>
            </Canvas>

            <Grid x:Name="CardVisual">
                <Grid.RenderTransform>
                    <TransformGroup>
                        <TranslateTransform x:Name="CardPosition" Y="0"/>
                        <TranslateTransform x:Name="CardSlide" Y="0"/>
                    </TransformGroup>
                </Grid.RenderTransform>

                <!-- Shadow plate: a filled rect at exactly the card's size, so only the blurred silhouette
                     escapes past the glass. Any border here paints a crisp frame, so there is none, and the
                     layout gutter (CardEdgeGutter) is wider than the blur so the halo never ends at an edge. -->
                <Border CornerRadius="12"
                        Background="#02060F"
                        IsHitTestVisible="False">
                    <Border.Effect>
                        <DropShadowEffect Color="#02060F" BlurRadius="28" ShadowDepth="8" Direction="270" Opacity="0.45"/>
                    </Border.Effect>
                </Border>

                <Border CornerRadius="12"
                        Background="{DynamicResource CommandSearchGlassBrush}"
                        BorderBrush="{StaticResource GlassHairlineBrush}"
                        BorderThickness="1">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <!-- Specular rim over the luminous accent line and its bloom -->
                        <Grid Grid.Row="0" Height="2">
                            <Border Height="1" VerticalAlignment="Top" Background="{StaticResource GlassSpecularBrush}"/>
                            <Border Height="1" VerticalAlignment="Bottom" Background="{DynamicResource AccentBrush}" Opacity="0.8">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <GradientStop Color="#00000000" Offset="0"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.3"/>
                                        <GradientStop Color="#FFFFFFFF" Offset="0.7"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                            <Border Height="26" VerticalAlignment="Top" IsHitTestVisible="False"
                                    Background="{DynamicResource AccentBrush}" Opacity="0.06">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                        <GradientStop Color="#FFFFFFFF" Offset="0"/>
                                        <GradientStop Color="#00000000" Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>

                        <!-- Query field -->
                        <Grid Grid.Row="1" Margin="22,18,18,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0">
                                <TextBlock x:Name="PlaceholderText"
                                           Text="Search modules and tabs"
                                           FontSize="18"
                                           Foreground="{DynamicResource CommandSearchPlaceholderBrush}"
                                           VerticalAlignment="Center"
                                           Margin="1,0,0,1"
                                           IsHitTestVisible="False"/>
                                <TextBox x:Name="QueryBox"
                                         FontSize="18"
                                         Foreground="{DynamicResource TextBrush}"
                                         Background="Transparent"
                                         BorderThickness="0"
                                         Padding="0"
                                         CaretBrush="{DynamicResource TextBrush}"
                                         SelectionBrush="{DynamicResource AccentBrush}"
                                         SelectionOpacity="0.35"
                                         VerticalContentAlignment="Center"
                                         FocusVisualStyle="{x:Null}"
                                         SpellCheck.IsEnabled="False"
                                         AutomationProperties.Name="Search modules and settings"
                                         AutomationProperties.HelpText="Type to filter. Up and down move the selection. Enter jumps to the selected row. F2 toggles it; Ctrl+Space does the same unless a CJK IME claims the chord."
                                         TextChanged="QueryBox_TextChanged"
                                         PreviewKeyDown="QueryBox_PreviewKeyDown"/>
                            </Grid>

                            <Button Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource EscChipStyle}"
                                    Click="CloseChip_Click"
                                    ToolTip="Close (Esc)"
                                    AutomationProperties.Name="Close search">
                                <TextBlock Text="esc" FontSize="10" FontFamily="Consolas"/>
                            </Button>
                        </Grid>

                        <Border Grid.Row="2" Height="1" Background="{DynamicResource SliderBgBrush}"/>

                        <!-- Results: 50 px rows, so whole rows fit and none is ever sliced. The height cap comes
                             from code: a short window scrolls the list instead of sliding the card, so the
                             query field keeps its place while typing. MinHeight is that cap's floor. -->
                        <Grid x:Name="ResultsArea" Grid.Row="3" MinHeight="100">
                            <ScrollViewer x:Name="ResultsScroll"
                                          MaxHeight="300"
                                          Margin="0,6,0,6"
                                          VerticalScrollBarVisibility="Auto"
                                          HorizontalScrollBarVisibility="Disabled"
                                          Focusable="False">
                                <views:CommandSearchResults x:Name="ResultsList"
                                                            Margin="0,0,4,0"
                                                            Focusable="False"
                                                            AutomationProperties.Name="Search results"
                                                            AutomationProperties.LiveSetting="Polite">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <views:CommandSearchRow HorizontalContentAlignment="Stretch"
                                                                    VerticalContentAlignment="Stretch"
                                                                    Focusable="False"
                                                                    IsTabStop="False"
                                                                    AutomationProperties.Name="{Binding DisplayName}"
                                                                    AutomationProperties.HelpText="{Binding HintText}">
                                                <Border Height="48" CornerRadius="7" Margin="10,1" BorderThickness="0"
                                                        Background="Transparent"
                                                        MouseLeftButtonUp="Row_MouseLeftButtonUp">
                                                    <Grid>
                                                        <!-- Hover wash from TextBrush at low opacity: palette-derived, so a
                                                             light palette darkens the row instead of washing it white. A
                                                             separate layer, because Opacity on the row would dim its text -->
                                                        <Border CornerRadius="7" IsHitTestVisible="False"
                                                                Background="{DynamicResource TextBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Opacity" Value="0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType={x:Type views:CommandSearchRow}}}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.08"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <!-- Selected: neutral wash plus an accent rule, no coral wash -->
                                                        <Border CornerRadius="7" IsHitTestVisible="False"
                                                                Background="{DynamicResource TextBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Opacity" Value="0"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Opacity" Value="0.14"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>
                                                        <Border CornerRadius="7,0,0,7" IsHitTestVisible="False"
                                                                BorderThickness="2,0,0,0"
                                                                BorderBrush="{DynamicResource AccentBrush}">
                                                            <Border.Style>
                                                                <Style TargetType="Border">
                                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                                            <Setter Property="Visibility" Value="Visible"/>
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </Border.Style>
                                                        </Border>

                                                        <Grid Margin="12,7">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="56"/>
                                                            </Grid.ColumnDefinitions>

                                                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                                                <views:HighlightTextBlock x:Name="RowName"
                                                                                          SourceText="{Binding DisplayName}"
                                                                                          MatchRanges="{Binding MatchRanges}"
                                                                                          HighlightBrush="{DynamicResource CommandSearchMatchBrush}"
                                                                                          HighlightBackground="{DynamicResource CommandSearchMatchPillBrush}"
                                                                                          FontSize="14"
                                                                                          FontWeight="SemiBold"
                                                                                          Foreground="{DynamicResource TextBrush}"
                                                                                          TextTrimming="CharacterEllipsis">
                                                                    <views:HighlightTextBlock.Style>
                                                                        <Style TargetType="views:HighlightTextBlock">
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                                    <Setter Property="Opacity" Value="0.72"/>
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </views:HighlightTextBlock.Style>
                                                                </views:HighlightTextBlock>
                                                                <TextBlock Text="{Binding HintText}"
                                                                           FontSize="11"
                                                                           Margin="0,1,0,0"
                                                                           Style="{StaticResource RowSecondaryTextStyle}"
                                                                           TextTrimming="CharacterEllipsis"/>
                                                            </StackPanel>

                                                            <Border Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Padding="6,2" CornerRadius="4" BorderThickness="1"
                                                                    Background="{DynamicResource SliderBgBrush}"
                                                                    BorderBrush="{DynamicResource SliderFgBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowKeybind}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="{Binding KeybindText}"
                                                                           FontSize="10"
                                                                           FontFamily="Consolas"
                                                                           Foreground="{DynamicResource CommandSearchSubtleTextBrush}"/>
                                                            </Border>

                                                            <Border Grid.Column="2" Margin="8,0,0,0" VerticalAlignment="Center"
                                                                    Padding="6,2" CornerRadius="4" BorderThickness="1"
                                                                    Background="Transparent"
                                                                    BorderBrush="{DynamicResource SliderFgBrush}">
                                                                <Border.Style>
                                                                    <Style TargetType="Border">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding IsAvailable}" Value="False">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Border.Style>
                                                                <TextBlock Text="UNAVAILABLE"
                                                                           FontSize="9"
                                                                           FontWeight="Bold"
                                                                           Style="{StaticResource RowSecondaryTextStyle}"/>
                                                            </Border>

                                                            <!-- Same switch geometry as the product's ModuleSwitch, static state
                                                                 only, and disabled unless the bridge can run the module: an offer
                                                                 the toggle path would refuse is how a switch ends up lying. TwoWay
                                                                 on purpose: a click writes to the row, so the binding survives and
                                                                 the re-read value can put the thumb back. -->
                                                            <CheckBox Grid.Column="3"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"
                                                                      Focusable="False"
                                                                      IsTabStop="False"
                                                                      Cursor="Hand"
                                                                      ToolTip="Toggle module"
                                                                      IsChecked="{Binding IsOn, Mode=TwoWay}"
                                                                      IsEnabled="{Binding IsAvailable}"
                                                                      AutomationProperties.LabeledBy="{Binding ElementName=RowName}">
                                                                <CheckBox.Style>
                                                                    <Style TargetType="CheckBox" BasedOn="{StaticResource RowSwitchStyle}">
                                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding ShowSwitch}" Value="True">
                                                                                <Setter Property="Visibility" Value="Visible"/>
                                                                            </DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </CheckBox.Style>
                                                            </CheckBox>
                                                        </Grid>
                                                    </Grid>
                                                </Border>
                                            </views:CommandSearchRow>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </views:CommandSearchResults>
                            </ScrollViewer>

                            <TextBlock x:Name="EmptyText"
                                       Visibility="Collapsed"
                                       Margin="22,20,22,26"
                                       FontSize="12"
                                       TextWrapping="Wrap"
                                       Foreground="{DynamicResource DimTextBrush}"
                                       AutomationProperties.LiveSetting="Polite"/>
                        </Grid>

                        <!-- Keyboard legend -->
                        <Grid Grid.Row="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>

                            <Border Grid.ColumnSpan="2" Height="1" VerticalAlignment="Top" Background="{DynamicResource SliderBgBrush}"/>

                            <WrapPanel Grid.Column="0" Margin="22,10,12,12" Orientation="Horizontal">
                                <TextBlock FontSize="10.5" Margin="0,0,16,0">
                                    <Run Text="up/down" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text=" navigate"/>
                                </TextBlock>
                                <TextBlock FontSize="10.5" Margin="0,0,16,0">
                                    <Run Text="enter" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text=" jump"/>
                                </TextBlock>
                                <!-- F2 rather than Ctrl+Space in the legend: Microsoft's CJK IMEs take Ctrl+Space
                                     as their own on/off chord, so it never reaches the app there. Both work. -->
                                <TextBlock FontSize="10.5" Margin="0,0,16,0"
                                           ToolTip="F2 toggles the selected row. Ctrl+Space does the same outside a CJK IME.">
                                    <Run Text="f2" FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}"/>
                                    <Run Text=" toggle"/>
                                </TextBlock>
                            </WrapPanel>

                            <TextBlock x:Name="ResultsCount"
                                       Grid.Column="1"
                                       Margin="0,10,18,0"
                                       VerticalAlignment="Top"
                                       FontSize="10.5"
                                       Foreground="{DynamicResource DimTextBrush}"
                                       IsHitTestVisible="False"/>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
