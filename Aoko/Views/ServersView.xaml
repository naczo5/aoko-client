<UserControl x:Class="Aoko.Views.ServersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="Transparent"
             FontFamily="Segoe UI"
             FontSize="12"
             UseLayoutRounding="True"
             SnapsToDevicePixels="True"
             Loaded="View_Loaded"
             Unloaded="View_Unloaded">

    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="TabStyles.xaml"/>
            </ResourceDictionary.MergedDictionaries>

            <!--
                Saved server row: a Button so the whole row is clickable, with the same
                hover wash and 2px selection rule as an account card.
            -->
            <Style x:Key="ServerCardButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource PanelBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                <Setter Property="BorderBrush" Value="{DynamicResource SliderFgBrush}"/>
                <Setter Property="BorderThickness" Value="1"/>
                <Setter Property="Padding" Value="12"/>
                <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                <Setter Property="VerticalContentAlignment" Value="Center"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
                <Setter Property="ToolTipService.ShowOnDisabled" Value="True"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Card"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="8">
                                <Grid>
                                    <Border x:Name="Wash" Style="{StaticResource TabCardWash}"/>
                                    <Border Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                    </Border>
                                    <Border x:Name="Rule" Style="{StaticResource TabSelectionRule}"/>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Wash" Property="Opacity" Value="0.06"/>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Wash" Property="Opacity" Value="0.06"/>
                                    <Setter TargetName="Card" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                    <Setter TargetName="Wash" Property="Opacity" Value="0.12"/>
                                    <Setter TargetName="Rule" Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Latency chip: keyboard reachable, named for a screen reader, brightens on
                hover instead of dimming, and never widens enough to squeeze the row.
            -->
            <Style x:Key="ServerChipButton" TargetType="Button">
                <Setter Property="Background" Value="Transparent"/>
                <Setter Property="Foreground" Value="{DynamicResource DimTextBrush}"/>
                <Setter Property="FontSize" Value="11"/>
                <Setter Property="Padding" Value="7,2"/>
                <Setter Property="MaxWidth" Value="110"/>
                <Setter Property="Cursor" Value="Hand"/>
                <Setter Property="FocusVisualStyle" Value="{StaticResource TabFocusVisual}"/>
                <Setter Property="AutomationProperties.Name" Value="Ping again"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Grid>
                                <Border x:Name="Tint"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="4"
                                        Opacity="0"/>
                                <Border x:Name="HoverWash"
                                        Background="{DynamicResource AccentBrush}"
                                        CornerRadius="4"
                                        Opacity="0"/>
                                <Border x:Name="Chip"
                                        Background="{TemplateBinding Background}"
                                        BorderBrush="{DynamicResource SliderFgBrush}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="{TemplateBinding Padding}">
                                    <TextBlock Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}"
                                               Foreground="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}"
                                               FontSize="{TemplateBinding FontSize}"
                                               TextTrimming="CharacterEllipsis"/>
                                </Border>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverWash" Property="Opacity" Value="0.06"/>
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                </Trigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Accent">
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.16"/>
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Warn">
                                    <Setter TargetName="Tint" Property="Background" Value="{StaticResource WarnBrush}"/>
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.16"/>
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource WarnBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusTone}" Value="Critical">
                                    <Setter TargetName="Tint" Property="Background" Value="{StaticResource CriticalBrush}"/>
                                    <Setter TargetName="Tint" Property="Opacity" Value="0.2"/>
                                    <Setter TargetName="Chip" Property="BorderBrush" Value="{StaticResource CriticalBrush}"/>
                                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                </DataTrigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Thin indeterminate run; costs no layout beyond the 3px track. -->
            <Style x:Key="ServerBusyBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="3"/>
                <Setter Property="IsIndeterminate" Value="True"/>
                <Setter Property="BorderThickness" Value="0"/>
                <Setter Property="Background" Value="{DynamicResource SliderBgBrush}"/>
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}" CornerRadius="2" ClipToBounds="True">
                                <Canvas Height="3">
                                    <Border x:Name="run"
                                            Width="96"
                                            Height="3"
                                            Canvas.Left="-96"
                                            CornerRadius="2"
                                            Background="{TemplateBinding Foreground}"/>
                                </Canvas>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsIndeterminate" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard x:Name="runStoryboard">
                                            <Storyboard RepeatBehavior="Forever">
                                                <DoubleAnimation Storyboard.TargetName="run"
                                                                 Storyboard.TargetProperty="(Canvas.Left)"
                                                                 From="-96"
                                                                 To="960"
                                                                 Duration="0:0:2.2"/>
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <StopStoryboard BeginStoryboardName="runStoryboard"/>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </UserControl.Resources>

    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Row 0: subtitle -->
        <TextBlock Grid.Row="0"
                   Text="Join a server without leaving aoko."
                   Foreground="{DynamicResource DimTextBrush}"
                   FontSize="12"
                   TextWrapping="Wrap"
                   Margin="0,0,0,12"/>

        <!-- Row 1: direct connect -->
        <Border Grid.Row="1"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource SliderFgBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Text="Direct connect" Style="{StaticResource TabSectionTitle}"/>
                <TextBlock Text="Host or host:port"
                           Style="{StaticResource TabCaption}"
                           Margin="0,8,0,4"/>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="DirectAddressBox"
                             Grid.Column="0"
                             Style="{StaticResource TabTextBox}"
                             KeyDown="DirectAddressBox_KeyDown"
                             ToolTip="Server address, for example play.example.net or play.example.net:25566"/>
                    <Button x:Name="DirectJoinButton"
                            Grid.Column="1"
                            Content="Join"
                            Style="{StaticResource TabPrimaryButton}"
                            Margin="8,0,0,0"
                            Click="DirectJoinButton_Click"/>
                </Grid>
                <TextBlock x:Name="DirectValidationText"
                           Style="{StaticResource TabCaption}"
                           Foreground="{DynamicResource CriticalBrush}"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Row 2: saved servers -->
        <Grid Grid.Row="2">
            <ScrollViewer VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          HorizontalContentAlignment="Stretch">
                <ItemsControl x:Name="ServersList"
                              KeyboardNavigation.TabNavigation="Once"
                              KeyboardNavigation.DirectionalNavigation="Continue">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource ServerCardButton}"
                                    MinHeight="64"
                                    Margin="0,0,0,8"
                                    Click="ServerCard_Click"
                                    MouseDoubleClick="ServerCard_DoubleClick"
                                    GotKeyboardFocus="ServerCard_GotKeyboardFocus"
                                    AutomationProperties.Name="{Binding AutomationName}"
                                    AutomationProperties.ItemStatus="{Binding SelectionStatus}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <StackPanel Grid.Column="0" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock Text="{Binding Name}"
                                                   Foreground="{DynamicResource TextBrush}"
                                                   FontSize="12"
                                                   FontWeight="SemiBold"
                                                   TextTrimming="CharacterEllipsis"/>
                                        <TextBlock Text="{Binding Address}"
                                                   Foreground="{DynamicResource DimTextBrush}"
                                                   FontSize="11"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,2,0,0"/>
                                        <TextBlock Text="{Binding Motd}"
                                                   FontSize="11"
                                                   Foreground="{DynamicResource DimTextBrush}"
                                                   TextWrapping="Wrap"
                                                   MaxHeight="30"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding HasMotd}" Value="True">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Style="{StaticResource ServerChipButton}"
                                                    Content="{Binding StatusText}"
                                                    Click="LatencyChip_Click"
                                                    AutomationProperties.HelpText="{Binding Address}"
                                                    ToolTip="Ping this server again"/>
                                            <TextBlock Text="{Binding PlayersLabel}"
                                                       FontSize="11"
                                                       Foreground="{DynamicResource DimTextBrush}"
                                                       Margin="8,0,0,0"
                                                       VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasPlayers}" Value="True">
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                        <TextBlock Text="{Binding LastJoinedLabel}"
                                                   Foreground="{DynamicResource DimTextBrush}"
                                                   FontSize="11"
                                                   HorizontalAlignment="Right"
                                                   TextTrimming="CharacterEllipsis"
                                                   Margin="0,4,0,0"/>
                                    </StackPanel>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <StackPanel x:Name="EmptyState"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Margin="24"
                        Visibility="Collapsed">
                <TextBlock Text="No saved servers" Style="{StaticResource TabEmptyTitle}"/>
                <TextBlock Text="Join a server above, or add one to ping and join it later."
                           Style="{StaticResource TabEmptyBody}"/>
                <Button Content="Add a server"
                        Style="{StaticResource TabPrimaryButton}"
                        HorizontalAlignment="Center"
                        Margin="0,12,0,0"
                        Click="AddServerButton_Click"/>
            </StackPanel>
        </Grid>

        <!-- Row 3: inline add form, collapsed until "Add server" is used -->
        <Border x:Name="AddFormCard"
                Grid.Row="3"
                Background="{DynamicResource PanelBrush}"
                BorderBrush="{DynamicResource SliderFgBrush}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="12"
                Margin="0,8,0,0"
                Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Add a server" Style="{StaticResource TabSectionTitle}"/>
                <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,8,0">
                        <TextBlock Text="Name" Style="{StaticResource TabCaption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AddNameBox"
                                 Style="{StaticResource TabTextBox}"
                                 ToolTip="Optional label. The address is used when this is empty."/>
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,8,0">
                        <TextBlock Text="Host or host:port" Style="{StaticResource TabCaption}" Margin="0,0,0,4"/>
                        <TextBox x:Name="AddAddressBox"
                                 Style="{StaticResource TabTextBox}"
                                 KeyDown="AddAddressBox_KeyDown"/>
                    </StackPanel>

                    <Button x:Name="AddFormAddButton"
                            Grid.Column="2"
                            Content="Add"
                            Style="{StaticResource TabPrimaryButton}"
                            VerticalAlignment="Bottom"
                            Margin="0,0,8,0"
                            Click="AddFormAddButton_Click"
                            ToolTip="Save this address as a server"/>
                    <Button x:Name="AddFormCancelButton"
                            Grid.Column="3"
                            Content="Cancel"
                            Style="{StaticResource TabSecondaryButton}"
                            VerticalAlignment="Bottom"
                            IsCancel="True"
                            Click="AddFormCancelButton_Click"
                            ToolTip="Close this form without saving"/>
                </Grid>
                <TextBlock x:Name="AddFormValidationText"
                           Style="{StaticResource TabCaption}"
                           Foreground="{DynamicResource CriticalBrush}"
                           Margin="0,4,0,0"
                           Visibility="Collapsed"/>
            </StackPanel>
        </Border>

        <!-- Row 4: last result and any recovered-store notice -->
        <StackPanel Grid.Row="4" Margin="0,8,0,0">
            <ProgressBar x:Name="BusyBar"
                         Style="{StaticResource ServerBusyBar}"
                         Margin="0,0,0,4"
                         Visibility="Collapsed"/>
            <TextBlock x:Name="StatusLine"
                       Style="{StaticResource TabStatusText}"
                       Visibility="Collapsed"/>
            <TextBlock x:Name="RecoveryText"
                       Style="{StaticResource TabStatusText}"
                       Foreground="{DynamicResource CriticalBrush}"
                       Visibility="Collapsed"
                       Margin="0,4,0,0"/>
        </StackPanel>

        <!-- Row 5: sticky footer: persistent hint, then the actions -->
        <StackPanel Grid.Row="5" Margin="0,8,0,0">
            <TextBlock x:Name="PrimaryHint" Style="{StaticResource TabStatusText}" Margin="0,0,0,8"/>
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <Button x:Name="JoinSelectedButton"
                        Grid.Column="0"
                        Content="Join selected"
                        Style="{StaticResource TabPrimaryButton}"
                        Click="JoinSelectedButton_Click"/>
                <Button x:Name="AddServerButton"
                        Grid.Column="1"
                        Content="Add server"
                        Style="{StaticResource TabSecondaryButton}"
                        Margin="8,0,0,0"
                        Click="AddServerButton_Click"
                        ToolTip="Save a server, then ping and join it later"/>
                <Button x:Name="PingAllButton"
                        Grid.Column="2"
                        Content="Ping all"
                        Style="{StaticResource TabSecondaryButton}"
                        Margin="8,0,0,0"
                        Click="PingAllButton_Click"/>
                <Button x:Name="DeleteButton"
                        Grid.Column="4"
                        Content="Delete"
                        Style="{StaticResource TabDangerButton}"
                        Click="DeleteButton_Click"/>
            </Grid>
        </StackPanel>
    </Grid>
</UserControl>
